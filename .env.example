# =============================================================================
# Budgety environment variables (template — no real secrets)
# =============================================================================
#
# Local development:
#   cp .env.example .env.local
#   Fill in values in .env.local (gitignored)
#
# Vercel production / preview:
#   Set values in the Vercel dashboard or: npx vercel env pull .env.local
#   See docs/VERCEL_ENV.md
#
# =============================================================================

# --- Data store (server) ---

# Neon PostgreSQL — stores budget data (transactions, budgets, goals, ...).
# Use the POOLED connection string on Vercel/serverless.
# Example: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Authentication: Firebase (client, public) ---
#
# These NEXT_PUBLIC_* values are safe to expose to the browser. Copy them from
# the Firebase console: Project settings → General → Your apps → Web app → SDK
# setup and configuration. See docs/AUTH_SETUP.md.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Local testing only: Firebase Auth emulator ---
#
# When set, the client connects to the local Auth emulator instead of the real
# Firebase backend (no project/login required). Leave empty in production.
# Start it with: npm run emulators
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
