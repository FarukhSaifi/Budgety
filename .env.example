# =============================================================================
# Budgety environment variables (template — no real secrets)
# =============================================================================
#
# Local development:
#   cp .env.example .env.local
#   Fill in values in .env.local (gitignored)
#
# =============================================================================

# --- Authentication & data: Firebase (client, public) ---
#
# Copy from Firebase console → Project settings → Your apps → Web app.
# Auth + Firestore are the only backend for Budgety (no Neon / Better Auth).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Local testing only: Firebase Auth emulator ---
#
# When set, the client connects to the local Auth emulator instead of the real
# Firebase backend. Leave empty in production.
# Start it with: npm run emulators
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- AI bank statement import (server-only; never expose to the client) ---
#
# Used by POST /api/parse-statement to turn PDF/CSV text into transactions.
# Provider order: Google Gemini first, then OpenAI if Google key is missing.
#
# Preferred — Gemini Developer API (Google AI Studio):
#   https://aistudio.google.com/apikey
# Either env name works (GOOGLE_GENERATIVE_AI_API_KEY is preferred):
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY=
#
# Optional fallback — OpenAI:
#   https://platform.openai.com/api-keys
OPENAI_API_KEY=
#
# Note: Firebase AI Logic is client-oriented (App Check). This API route uses
# the Gemini Developer REST API with a server-only key instead.
